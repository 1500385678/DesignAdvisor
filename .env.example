# DesignAdvisor · 环境变量样例
# 复制为 .env 并填入真实值;本文件已通过 .gitignore 排除

# 前端公开 API 基址(Next.js 浏览器侧可见)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 后端 CORS 白名单(逗号分隔)
CORS_ORIGINS=http://localhost:3000

# 数据层 — Phase 0 用 SQLite,Phase 2 切 PostgreSQL
DATABASE_URL=sqlite:///./data/designadvisor.db

# Figma 集成(Phase 0 #3 启用)
FIGMA_TOKEN=
FIGMA_TEAM_ID=

# LLM(Phase 1 AI 草稿)
LLM_PROVIDER=claude
LLM_API_KEY=
