# DesignAdvisor · 环境变量样例
# 复制为 .env 并填入真实值;本文件已通过 .gitignore 排除

# 前端公开 API 基址(Next.js 浏览器侧可见)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 后端 CORS 白名单(逗号分隔)
CORS_ORIGINS=http://localhost:3000

# 数据层 — Phase 0 用 SQLite,Phase 2 切 PostgreSQL
DATABASE_URL=sqlite:///./data/designadvisor.db

# Figma 集成(Phase 0 #3 启用)
FIGMA_TOKEN=
FIGMA_TEAM_ID=

# LLM(Phase 1 AI 草稿)
LLM_PROVIDER=claude
LLM_API_KEY=

# 飞书 bot 试运行(Phase 0 #4)
FEISHU_BOT_DRY_RUN=1                  # 1=离线模式(只 print 不真发,默认);0=真发,谨慎
LARK_CLI_BIN=lark-cli                 # lark-cli 可执行路径
LARK_PROFILE=design                   # lark-cli profile 名(对齐 36 行业约定)
FEISHU_BOT_VERIFY_TOKEN=              # 飞书后台"事件订阅 Verification Token"(同时作为 HMAC secret),留空=跳过验签
FEISHU_BOT_TIMESTAMP_TOLERANCE=300    # 时间戳容差(秒),防 replay,0=不校验
FEISHU_BOT_RATE_LIMIT_ENABLED=1       # 1=启用每 chat_id 限流(默认),0=关闭
FEISHU_BOT_RATE_LIMIT_RPS=1.0         # 每秒补充 token 数(默认 1.0,0=关闭),每 chat_id 独立 token bucket
FEISHU_BOT_RATE_LIMIT_BURST=3         # 桶容量(默认 3,即瞬时允许连发 3 条,超过触发限流)
FEISHU_BOT_HIT_LOG_ENABLED=0          # 1=启用命中日志(纯本地 JSONL,5 设计师 dogfood 审计面,默认关闭),0=关闭
FEISHU_BOT_HIT_LOG_PATH=./data/bot_hit_log.jsonl  # 命中日志落盘路径(父目录自动 mkdir -p)
FEISHU_REVIEW_NOTIFY_ENABLED=0        # 1=启用评审飞书通知(Phase 1 #2 切第四刀 v0.1,默认关闭试运行安全),0=关闭
FEISHU_REVIEW_NOTIFY_CHAT_ID=         # 接收评审通知的飞书群 oc_xxx(必填,未配 FEISHU_REVIEW_NOTIFY_ENABLED 自动 False)
